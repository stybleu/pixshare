{
  "manifest_version": 3,
  "name": "PixShare",
  "version": "1.0.0",
  "description": "Envoyez une image ou une capture de la page sur PixShare en un clic, et récupérez le lien (compte PixShare requis).",
  "permissions": ["contextMenus", "activeTab", "storage", "notifications", "clipboardWrite", "offscreen"],
  "host_permissions": ["https://pixshare.fr/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "PixShare",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png"}
  },
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "browser_specific_settings": {"gecko": {"id": "extension@pixshare.fr", "strict_min_version": "121.0"}}
}
